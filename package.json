{
  "name": "btbm-lngi",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time LNGI visualization of the BTBMS ordinal walk, with conversions to weaker notations.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node scripts/ensure-wasm.mjs && vite",
    "build": "node scripts/ensure-wasm.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "wasm-pack build --target web --out-dir src/wasm --out-name btbm_core"
  },
  "dependencies": {
    "katex": "0.19.1",
    "vue": "3.6.0-rc.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
